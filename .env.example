# Base origin of the API server, without a trailing slash.
# The ESRA report path (/api/esra/personal) is appended by src/api.ts.
VITE_API_HOST=http://localhost:8000

# Cloudflare Turnstile site key (dashboard: Turnstile -> Add a site).
# This is the PUBLIC key and is safe in the browser. The secret key must only
# ever live in your backend, which verifies the token on every submission.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
